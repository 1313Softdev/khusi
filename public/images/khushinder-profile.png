<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="600" height="600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B192C" />
      <stop offset="50%" stop-color="#1E293B" />
      <stop offset="100%" stop-color="#334E68" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#0B192C" stop-opacity="0" />
    </radialGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000" flood-opacity="0.5"/>
    </filter>
  </defs>
  
  <rect width="100%" height="100%" fill="url(#bg)" />
  <rect width="100%" height="100%" fill="url(#glow)" />

  <!-- Subtle Decorative geometric lines -->
  <circle cx="300" cy="300" r="240" fill="none" stroke="#F59E0B" stroke-width="1.5" stroke-dasharray="8 6" opacity="0.25" />
  <circle cx="300" cy="300" r="180" fill="none" stroke="#ffffff" stroke-width="1" opacity="0.15" />

  <g transform="translate(0, 0)">
    <!-- Badge -->
    <rect x="140" y="108" width="320" height="32" rx="16" fill="#F59E0B" fill-opacity="0.2" stroke="#F59E0B" stroke-width="1.5" />
    <text x="300" y="128" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="700" fill="#FBBF24" text-anchor="middle" letter-spacing="2">COMMUNITY SERVICE</text>

    <!-- Main Title -->
    <text x="300" y="288" font-family="system-ui, -apple-system, sans-serif" font-size="27.272727272727273" font-weight="800" fill="#FFFFFF" text-anchor="middle" filter="url(#shadow)">
      S. Khushinder Singh
    </text>

    <!-- Subtitle -->
    <text x="300" y="348" font-family="system-ui, -apple-system, sans-serif" font-size="14.285714285714286" font-weight="500" fill="#E2E8F0" text-anchor="middle" opacity="0.95">
      Jand Sahib, Punjab
    </text>

    <!-- Cultural emblem representation -->
    <g transform="translate(270, 432) scale(0.6)">
      <path d="M50 0 L100 40 L80 100 L20 100 L0 40 Z" fill="#F59E0B" opacity="0.9" />
      <circle cx="50" cy="50" r="24" fill="#0B192C" />
      <path d="M50 30 L55 45 L70 45 L58 55 L62 70 L50 60 L38 70 L42 55 L30 45 L45 45 Z" fill="#FBBF24" />
    </g>
  </g>
</svg>