# =====================================================================
# Sardar Khushinder Singh Jand Sahib - Official Website
# Hostinger Production Environment Configuration (.env)
# =====================================================================

# 1. DATABASE CONFIGURATION (Hostinger MySQL)
# Format: mysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/<DB_NAME>
# In Hostinger hPanel, create a database (e.g. u123456789_khushinder) and user
DATABASE_URL="mysql://u123456789_khushinder:YourStrongPasswordHere@localhost:3306/u123456789_khushinder"

# 2. APPLICATION AUTHENTICATION
# Strong secret key for JWT session tokens (keep this secret)
JWT_SECRET="khushinder_punjab_sanjhivalta_dal_super_secret_jwt_key_2026_hostinger_prod"

# 3. PUBLIC SITE URL
# Change this to your live domain or temporary Hostinger URL
NEXT_PUBLIC_SITE_URL="https://khushindersingh.org"

# 4. SERVER CONFIGURATION
PORT=3000
NODE_ENV=production

# 5. GOOGLE GEMINI AI ASSISTANT (Optional - for AI Citizen Widget)
# Leave blank to use the built-in verified factual engine, or add your Gemini API Key
GEMINI_API_KEY=""

# 6. SMTP EMAIL CONFIGURATION (Hostinger Webmail / Titan Mail)
# You can also configure this directly in the Admin Panel at /admin/smtp
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="contact@khushindersingh.org"
SMTP_PASS="YourEmailPasswordHere"
SMTP_FROM="contact@khushindersingh.org"
ADMIN_NOTIFICATION_EMAIL="contact@khushindersingh.org"

# 7. META (FACEBOOK & INSTAGRAM) GRAPH API (Optional)
# Can also be updated dynamically inside /admin/social
FACEBOOK_PAGE_ID=""
FACEBOOK_ACCESS_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""
INSTAGRAM_ACCESS_TOKEN=""
